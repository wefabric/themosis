{
  "name": "wefabric/themosis",
  "description": "Wefabric - Themosis, a WordPress framework.",
  "keywords": ["themosis", "framework", "wordpress", "wefabric"],
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Julien Lambé",
      "email": "julien@themosis.com",
      "homepage": "https://www.themosis.com/"
    },
    {
      "name": "Leo Flapper",
      "email": "leo@wefabric.nl",
      "homepage": "https://wefabric.nl/"
    }
  ],
  "type": "project",
  "repositories":[
    {
      "type": "vcs",
      "url": "git@bitbucket.org:slicklabs/wp-support.git"
    },
    {
      "type": "vcs",
      "url": "git@bitbucket.org:slicklabs/wp-style-customizer.git"
    },
    {
      "type": "vcs",
      "url": "git@bitbucket.org:slicklabs/wp-establishments.git"
    },
    {
      "type": "vcs",
      "url": "git@bitbucket.org:slicklabs/wp-faq.git"
    },
    {
      "type": "vcs",
      "url": "git@github.com:wefabric/themosis-framework.git"
    },
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "composer/installers": true,
      "johnpbloch/wordpress-core-installer": true
    }
  },
  "require": {
    "php": "^8.0",
    "johnpbloch/wordpress-core": "^6.0.0",
    "johnpbloch/wordpress-core-installer": "^2.0",
    "themosis/framework": "dev-wefabric-laravel-12",
    "wefabric/wp-establishments": "*",
    "wefabric/wp-faq": "*",
    "wefabric/wp-style-customizer": "*",
    "wefabric/wp-support": "dev-main"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0"
  },
  "extra":{
    "installer-paths": {
      "htdocs/content/plugins/{$name}/": ["type:wordpress-plugin"],
      "htdocs/content/mu-plugins/{$name}/": ["type:wordpress-muplugin"],
      "htdocs/content/themes/{$name}/": ["type:wordpress-theme"]
    },
    "wordpress-install-dir": {
      "johnpbloch/wordpress-core": "htdocs/cms"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Themosis\\Core\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.sample', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan vendor:publish --tag=themosis --force",
      "@php artisan key:generate --ansi",
      "@php artisan salts:generate --ansi",
      "@php artisan vendor:publish --tag=wp-support --force"
    ],
    "test": "phpunit"
  }
}
